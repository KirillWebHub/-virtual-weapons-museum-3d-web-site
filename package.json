{
  "name": "virtual-museum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-release.mjs",
    "preview": "vite preview",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "preview:pages": "node scripts/static-site.mjs --base-path /-virtual-weapons-museum-3d-web-site/ --port 4185"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "three": "0.186.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
